[
 {
  "name": "minimal object",
  "expect": "ok",
  "hex": "7b2261223a317d",
  "text": "{\"a\":1}"
 },
 {
  "name": "keys sorted, nested",
  "expect": "ok",
  "hex": "7b2261223a7b2262223a5b312c6e756c6c2c747275652c66616c73655d2c2263223a2278227d2c227a223a2d357d",
  "text": "{\"a\":{\"b\":[1,null,true,false],\"c\":\"x\"},\"z\":-5}"
 },
 {
  "name": "max safe integer",
  "expect": "ok",
  "hex": "7b226e223a393030373139393235343734303939317d",
  "text": "{\"n\":9007199254740991}"
 },
 {
  "name": "min safe integer",
  "expect": "ok",
  "hex": "7b226e223a2d393030373139393235343734303939317d",
  "text": "{\"n\":-9007199254740991}"
 },
 {
  "name": "non-ASCII stays raw UTF-8",
  "expect": "ok",
  "hex": "7b2273223a22c3a9e4b8adf09f9880227d",
  "text": "{\"s\":\"é中😀\"}"
 },
 {
  "name": "U+2028 and DEL stay raw",
  "expect": "ok",
  "hex": "7b2273223a22e280a87f227d",
  "text": "{\"s\":\" \"}"
 },
 {
  "name": "slash is not escaped",
  "expect": "ok",
  "hex": "7b2273223a22612f62227d",
  "text": "{\"s\":\"a/b\"}"
 },
 {
  "name": "short escapes",
  "expect": "ok",
  "hex": "7b2273223a225c225c5c5c625c665c6e5c725c74227d",
  "text": "{\"s\":\"\\\"\\\\\\b\\f\\n\\r\\t\"}"
 },
 {
  "name": "other controls are lowercase \\u00xx",
  "expect": "ok",
  "hex": "7b2273223a225c75303030305c7530303162227d",
  "text": "{\"s\":\"\\u0000\\u001b\"}"
 },
 {
  "name": "empty containers",
  "expect": "ok",
  "hex": "7b2261223a5b5d2c226f223a7b7d7d",
  "text": "{\"a\":[],\"o\":{}}"
 },
 {
  "name": "space after colon",
  "expect": "non-canonical",
  "hex": "7b2261223a20317d",
  "text": "{\"a\": 1}"
 },
 {
  "name": "keys out of order",
  "expect": "non-canonical",
  "hex": "7b2262223a312c2261223a327d",
  "text": "{\"b\":1,\"a\":2}"
 },
 {
  "name": "escaped plain letter",
  "expect": "non-canonical",
  "hex": "7b2273223a225c7530303431227d",
  "text": "{\"s\":\"\\u0041\"}"
 },
 {
  "name": "escaped slash",
  "expect": "non-canonical",
  "hex": "7b2273223a22615c2f62227d",
  "text": "{\"s\":\"a\\/b\"}"
 },
 {
  "name": "uppercase hex escape",
  "expect": "non-canonical",
  "hex": "7b2273223a225c7530303142227d",
  "text": "{\"s\":\"\\u001B\"}"
 },
 {
  "name": "escaped non-ASCII",
  "expect": "non-canonical",
  "hex": "7b2273223a225c7530306539227d",
  "text": "{\"s\":\"\\u00e9\"}"
 },
 {
  "name": "escaped astral pair",
  "expect": "non-canonical",
  "hex": "7b2273223a225c75643833645c7564653030227d",
  "text": "{\"s\":\"\\ud83d\\ude00\"}"
 },
 {
  "name": "negative zero",
  "expect": "non-canonical",
  "hex": "7b226e223a2d307d",
  "text": "{\"n\":-0}"
 },
 {
  "name": "trailing space",
  "expect": "non-canonical",
  "hex": "7b2261223a317d20",
  "text": "{\"a\":1} "
 },
 {
  "name": "float",
  "expect": "bad-json",
  "hex": "7b226e223a312e307d",
  "text": "{\"n\":1.0}"
 },
 {
  "name": "exponent",
  "expect": "bad-json",
  "hex": "7b226e223a3165327d",
  "text": "{\"n\":1e2}"
 },
 {
  "name": "NaN",
  "expect": "bad-json",
  "hex": "7b226e223a4e614e7d",
  "text": "{\"n\":NaN}"
 },
 {
  "name": "Infinity",
  "expect": "bad-json",
  "hex": "7b226e223a2d496e66696e6974797d",
  "text": "{\"n\":-Infinity}"
 },
 {
  "name": "integer above 2**53-1",
  "expect": "bad-json",
  "hex": "7b226e223a393030373139393235343734303939327d",
  "text": "{\"n\":9007199254740992}"
 },
 {
  "name": "duplicate key",
  "expect": "bad-json",
  "hex": "7b2261223a312c2261223a317d",
  "text": "{\"a\":1,\"a\":1}"
 },
 {
  "name": "uppercase key",
  "expect": "bad-json",
  "hex": "7b2241223a317d",
  "text": "{\"A\":1}"
 },
 {
  "name": "hyphenated key",
  "expect": "bad-json",
  "hex": "7b22612d62223a317d",
  "text": "{\"a-b\":1}"
 },
 {
  "name": "lone surrogate escape",
  "expect": "bad-json",
  "hex": "7b2273223a225c7564383030227d",
  "text": "{\"s\":\"\\ud800\"}"
 },
 {
  "name": "top level is not an object",
  "expect": "bad-json",
  "hex": "5b315d",
  "text": "[1]"
 },
 {
  "name": "leading zero",
  "expect": "bad-json",
  "hex": "7b226e223a30317d",
  "text": "{\"n\":01}"
 },
 {
  "name": "deep nesting",
  "expect": "bad-json",
  "repeat": {
   "prefix": "{\"a\":",
   "open": "[",
   "close": "]",
   "times": 100000,
   "suffix": "}"
  }
 },
 {
  "name": "invalid UTF-8",
  "expect": "bad-utf8",
  "hex": "7b2273223a22ff227d"
 },
 {
  "name": "overlong UTF-8 slash",
  "expect": "bad-utf8",
  "hex": "7b2273223a22c0af227d"
 }
]
